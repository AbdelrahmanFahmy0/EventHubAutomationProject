    async createSomething(request: APIRequestContext, someField: string): Promise<number> {
        const response = await request.post(this.endpoint, { data: this.requestBody(someField) /*, headers: this.requestHeaders */ });
        expect(response.status()).toBe(201);
        const responseBody = await response.json();
        return responseBody.data.id;
