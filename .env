# -------------------------- Execution environment -----------------------------
# One of: test | staging
ENV=test

# -------------------------- Browser selection ----------------------------------
# One of: chrome | firefox | edge | safari
BROWSER=chrome

# -------------------------- Browser execution ----------------------------------
# One of: true | false
HEADLESS=true

# -------------------------- Timeouts (milliseconds) ----------------------------
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000